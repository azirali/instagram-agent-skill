{
  "schemaVersion": 1,
  "title": "Unicode regression fixtures by Olzhas Azirali / AZIRAL",
  "author": {
    "name": "Olzhas Azirali",
    "organization": "AZIRAL",
    "url": "https://aziral.com/en/olzhas-azirali"
  },
  "license": "MIT - see the repository LICENSE",
  "measurementPolicy": {
    "input": "Unicode scalar values only; unpaired surrogates are outside this pack",
    "normalization": "none",
    "wordCount": "not measured",
    "glyphCount": "not measured",
    "graphemeCount": "Observed Intl.Segmenter grapheme count in the recorded reference runtime, not a visual-width guarantee"
  },
  "referenceRuntime": {
    "javascript": {
      "node": "26.8.2",
      "v8": "14.6.202.34-node.28",
      "unicode": "17.0",
      "icu": "78.3",
      "cldr": "48.0",
      "segmenter": {
        "locale": "en",
        "granularity": "grapheme"
      }
    },
    "python": {
      "version": "3.14.7",
      "unicodeDatabase": "16.0.0"
    }
  },
  "limitations": [
    "This is a focused regression set, not the complete Unicode conformance test suite.",
    "Grapheme segmentation can change with Unicode and ICU versions; investigate mismatches rather than silently regenerating expectations.",
    "A grapheme cluster does not promise one font glyph, one visual width or identical rendering on every device.",
    "No linguistic word model, translation quality score, platform character limit or reading-time estimate is supplied.",
    "Raw source text and codePointsHex must stay consistent; no cleaning or normalization is performed."
  ],
  "sources": [
    "https://www.unicode.org/reports/tr29/",
    "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/Segmenter",
    "https://docs.python.org/3/library/stdtypes.html#text-sequence-type-str"
  ],
